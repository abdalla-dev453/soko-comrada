# Base URL the frontend API client (src/api/client.js) targets.
# In local dev, Vite proxies /api to the Flask backend (see
# vite.config.js), so this can stay relative.
VITE_API_BASE_URL=/api

VITE_APP_NAME=Soko Comrada
VITE_DEFAULT_CURRENCY=KES
VITE_MPESA_TILL_NUMBER=000000
VITE_BOOST_FEE_KES=50
VITE_SUBSCRIPTION_FEE_KES=200