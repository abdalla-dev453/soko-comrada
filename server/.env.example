# --- Flask core ---
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=soko_comrada
DB_USER=soko_app
DB_PASSWORD=change-me
# Full SQLAlchemy URI is assembled from the above in config.py,
# but can be overridden directly here if needed:
# DATABASE_URL=mysql+pymysql://soko_app:change-me@localhost:3306/soko_comrada

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting (Flask-Limiter storage backend) ---
RATELIMIT_STORAGE_URI=memory://
# Production must use a shared store so limits cannot be bypassed across workers:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Student email verification ---
# Comma-separated list of allowed email domains for registration.
ALLOWED_STUDENT_EMAIL_DOMAINS=jkuat.ac.ke,ku.ac.ke,uonbi.ac.ke

# --- M-Pesa / payments (manual verification in MVP) ---
MPESA_TILL_NUMBER=000000
BOOST_FEE_KES=50
SUBSCRIPTION_FEE_KES=200

# --- Object storage (avatars/images) ---
UPLOAD_FOLDER=/tmp/soko-comrada-uploads
MAX_CONTENT_LENGTH_MB=5
