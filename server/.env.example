# --- Flask core ---
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=soko_comrada
DB_USER=soko_app
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Full SQLAlchemy URI is assembled from the above in config.py,
# but can be overridden directly here if needed:
# DATABASE_URL=mysql+pymysql://soko_app:change-me@localhost:3306/soko_comrada

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting (Flask-Limiter storage backend) ---
RATELIMIT_STORAGE_URI=memory://

# --- Student email verification ---
# Comma-separated list of allowed email domains for registration.
ALLOWED_STUDENT_EMAIL_DOMAINS=jkuat.ac.ke,ku.ac.ke,uonbi.ac.ke

# --- M-Pesa / payments (manual verification in MVP) ---
MPESA_TILL_NUMBER=000000
BOOST_FEE_KES=50
SUBSCRIPTION_FEE_KES=200

# --- Email fallback (critical notifications only — PRD §5.5) ---
# If SMTP_HOST is left blank, the notification service logs the
# email instead of sending it — safe default for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notifications@sokocomrada.app
SMTP_USE_TLS=true

# --- Phase 5: Daraja STK Push (leave blank to fall back to manual
#     M-Pesa code verification — see payment_service.submit_payment) ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Must be a publicly reachable URL (ngrok in dev) — Safaricom POSTs
# the payment result here.
DARAJA_CALLBACK_URL=
# Required whenever DARAJA_CALLBACK_URL is set. Add it to that callback URL
# as: https://example.com/api/payments/daraja/callback?token=<this-value>
DARAJA_CALLBACK_SECRET=change-me-to-a-long-random-value

# --- Phase 7: WhatsApp Business Cloud API (leave blank to fall back
#     to the SMTP email notification for critical events) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Object storage (avatars/images) ---
UPLOAD_FOLDER=/tmp/soko-comrada-uploads
MAX_CONTENT_LENGTH_MB=5
